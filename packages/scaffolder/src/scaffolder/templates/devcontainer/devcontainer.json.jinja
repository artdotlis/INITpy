{
    "customizations": {},
    "dockerComposeFile": [
        "../docker-compose.yml",
        "dev.docker-compose.yml"
    ],
    "initializeCommand": "if [ ! -f .env ]; then cat package.env > .env; fi",
    "name": "{{ project_name }}",
    "postAttachCommand": "just dev",
    "remoteUser": "devu",
    "runServices": [
        "dev"
    ],
    "service": "dev",
    "shutdownAction": "stopCompose",
    "updateRemoteUserUID": true,
    "workspaceFolder": "/workspace"
}
