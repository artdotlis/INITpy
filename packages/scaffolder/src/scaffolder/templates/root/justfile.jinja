set shell := ['''bash''', '''-cu''', '''[ "${CONTAINER:-}" = container ] || { echo "Error: run just inside the dev container only, exiting ..." >&2; exit 1; } && source bin/install/env.sh && : "${DISABLE_GIT_ADD:=0}" && eval "$0"''']

setup:
    bash "$BIN_INSTALL_UV"
{% if use_monorepo %}
    bash "$BIN_INSTALL_PNPM"
{% endif %}

dev: setup
    "$UVE" sync --frozen --all-groups
{% if use_monorepo %}
    "$PNPME" install --frozen-lockfile
{% endif %}
    if [ "$DISABLE_GIT_ADD" = "1" ]; then echo "Skipping git operations (DISABLE_GIT_ADD=1)"; else find .git/hooks -name "*.old" -delete; "$UVE" run lefthook uninstall 2>&1 || echo "not installed"; "$UVE" run lefthook install; fi

run-act:
    RAN=$$ && echo "source .venv/bin/activate; source bin/install/env.sh; rm /tmp/$RAN" > /tmp/$RAN && bash --init-file /tmp/$RAN

run-checks:
    if [ "$DISABLE_GIT_ADD" = "1" ]; then "$UVE" run lefthook run pre-commit --all-files -f --no-stage-fixed; else "$UVE" run lefthook run pre-commit --all-files -f; fi
{% if use_docs %}

run-docs:
    "$UVE" run griffe2md {{ package_name }} -o "$DOCS_REF_DIR/{{ package_name }}.md"
    mkdir -p "$DOCS_PARTIALS_DIR"
    sed -E '/^\[!\[/d' README.md > "$DOCS_PARTIALS_DIR/readme.md"
    cp LICENSE "$DOCS_PARTIALS_DIR/license.md"
    cd "$PKG_DOC" && "$PNPME" run build

serve-docs: run-docs
    cd "$PKG_DOC" && "$PNPME" run preview
{% endif %}

run-tests:
    "$UVE" run lefthook run tests

build: setup
{% if use_monorepo %}
    "$UVE" sync --frozen
    "$UVE" build --package {{ package_name }}
{% else %}
    "$UVE" sync --frozen --no-default-groups
    "$UVE" build
{% endif %}

run-build:
{% if use_monorepo %}
    "$UVE" build --package {{ package_name }}
{% else %}
    "$UVE" build
{% endif %}

bump:
    export DISABLE_GIT_ADD=0 && bash "$BIN_RUN_UNSTAGED" && NEW_VER=$("$UVE" run bash bin/install/bump.sh | tail -1) && echo "bumped to $NEW_VER" && git add . && git commit -am "bump: release $NEW_VER"

lock:
    "$UVE" lock
{% if use_docs %}
    cd "$PKG_DOC" && "$PNPME" install --lockfile-only
{% endif %}

update:
    "$UVE" lock -U
{% if use_docs %}
    cd "$PKG_DOC" && "$PNPME" update
{% endif %}

com commit:
    if [ -f .commit_msg ] && [ -s .commit_msg ]; then "$EDITOR" .commit_msg; git commit -F .commit_msg && rm -f .commit_msg; else "$UVE" run cz commit --write-message-to-file .commit_msg && rm -f .commit_msg; fi

clean:
    bash bin/install/clean.sh
