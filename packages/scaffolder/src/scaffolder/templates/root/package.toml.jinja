[project]
classifiers = ["Private :: Do Not Upload"]
name = "{{ package_name }}"
version = "{{ version }}"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.13,<4"
dependencies = []

[[project.authors]]
name = "{{ author_name }}"
email = "{{ author_email }}"
[tool.setuptools.packages.find]
where = ["src"]
include = ["{{ package_name }}"]

[build-system]
requires = ["uv_build>=0.11.26,<0.14.0"]
build-backend = "uv_build"

[tool.uv]
package = true

[tool.pytest.ini_options]
testpaths = ["tests"]
norecursedirs = ["__pycache__", ".pytest_cache"]

[tool.coverage.run]
source = ["{{ package_name }}"]
omit = ["tests/*"]
data_file = ".coverage.{{ package_name }}"

[tool.coverage.report]
show_missing = true
skip_empty = true
fail_under = 0
