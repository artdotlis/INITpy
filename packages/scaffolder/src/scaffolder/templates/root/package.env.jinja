COPYRIGHT="{{ copyright_holder }}"
{% if not use_monorepo %}PYV=3.13
UV_CACHE_DIR=.uv/cache
UV_INSTALL_DIR=.uv/bin
UV_PYTHON_BIN_DIR=.uv/python/bin
UV_TOOL_DIR=.uv/tools
UV_TOOL_BIN_DIR=.uv/tools/bin
UV_NO_MODIFY_PATH=1
UV_LINK_MODE=copy
UV_PYTHON_INSTALL_DIR=.uv/python
UV_HOME=.uv
UV_PROJECT_ENVIRONMENT=.venv
UV_VERSION=0.13.5
CONFIG_SHELL=configs/lint/shellcheckrc
BIN_RUN_ENV_LINT=bin/lint/lint_env.sh
BIN_RUN_LICENSE_LINT=bin/lint/licenses.sh
BIN_RUN_LFS_LINT=bin/lint/lfs_files.sh
BIN_RUN_UNSTAGED=bin/lint/unstaged.sh
BIN_INSTALL_UV=bin/install/uv.sh
PKG=src
# Required by docker compose; must be copied to ROOT/.env
BIN_DEPLOY_PREP=bin/deploy/prep.sh
BIN_DEPLOY_REQ=bin/deploy/req.sh
BIN_DEPLOY_USER=bin/deploy/user.sh
{% elif use_docs %}

PYV=3.13
UV_CACHE_DIR=.uv/cache
UV_INSTALL_DIR=.uv/bin
UV_PYTHON_BIN_DIR=.uv/python/bin
UV_TOOL_DIR=.uv/tools
UV_TOOL_BIN_DIR=.uv/tools/bin
UV_NO_MODIFY_PATH=1
UV_LINK_MODE=copy
UV_PYTHON_INSTALL_DIR=.uv/python
UV_HOME=.uv
UV_PROJECT_ENVIRONMENT=.venv

PNPM_HOME=.pnpm
PNPM_STORE=.pnpm-store
FNM_HOME=.fnm

UV_VERSION=0.13.5
PNPM_VERSION=12.21.0
NODE_VERSION=24

CONFIG_SHELL=configs/lint/shellcheckrc
CONFIG_DOCS=packages/docs/.vitepress/config.toml
CONFIG_PRETTIER=configs/lint/prettierrc.json

BIN_RUN_ENV_LINT=bin/lint/lint_env.sh
BIN_RUN_LICENSE_LINT=bin/lint/licenses.sh
BIN_RUN_LFS_LINT=bin/lint/lfs_files.sh
BIN_RUN_UNSTAGED=bin/lint/unstaged.sh
BIN_INSTALL_UV=bin/install/uv.sh
BIN_INSTALL_PNPM=bin/install/pnpm.sh

PKG=packages
PKG_DOC=packages/docs
{{ package_env_var }}=packages/{{ package_name }}


{{ package_env_file }}=packages/{{ package_name }}/.env
DOC_ENV=packages/docs/.env

# Required by docker compose; must be copied to ROOT/.env
BIN_DEPLOY_PREP=bin/deploy/prep.sh
BIN_DEPLOY_REQ=bin/deploy/req.sh
BIN_DEPLOY_USER=bin/deploy/user.sh

