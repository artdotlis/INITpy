# SPDX-FileCopyrightText: {{ year }} {{ copyright_holder }}
#
# SPDX-License-Identifier: CC0-1.0

saveExact: true
minimumReleaseAge: 4320
minimumReleaseAgeStrict: true

lockfile: true
preferFrozenLockfile: true
{% if use_docs %}

packages:
    - 'packages/docs'

# Define catalog of dependency versions (source of truth)
catalog:
    '@phosphor-icons/vue': '2.2.1'
    oxlint: '1.94.0'
    prettier: '3.10.1'
    '@types/node': '24.0.0'
    typescript: '7.1.0-beta'
    toml: '5.0.1'
    vitepress: '1.6.4'
    vitest: '2.1.9'
    vite: '5.4.21'
    vue: '3.5.45'
    '@vue/content-mapper': '4.0.0-alpha.3'
allowBuilds:
    esbuild: true
{% else %}

catalog:
  oxlint: '1.94.0'
  prettier: '3.10.1'
  '@types/node': '24.0.0'
  typescript: '7.1.0-beta'
  toml: '5.0.1'
  vitepress: '1.6.4'
  vitest: '2.1.9'
  vite: '5.4.21'
  vue: '3.5.45'
  '@vue/content-mapper': '4.0.0-alpha.3'
allowBuilds:
  esbuild: true
{% endif %}
