[site]
title = "{{ project_name }}"
description = "{{ project_name }} documentation"

[vitepress]
base = "/{{ project_slug }}/"
cleanUrls = true
srcDir = "src"
theme = "./theme"

[vitepress.markdown.theme]
light = "vitesse-light"
dark = "vitesse-dark"

[vitepress.themeConfig]
socialLinks = []
license = "{{ license }}"
[[vitepress.themeConfig.refPackages]]
name = "{{ package_name }}"

[vitepress.themeConfig.logo]
value = "🛠️"

[vitepress.themeConfig.search]
provider = "local"

[vitepress.themeConfig.docFooter]
prev = false
next = false

[[vitepress.themeConfig.nav]]
text = "Home"
link = "/"

[[vitepress.themeConfig.nav]]
text = "About"
link = "/about/"

[[vitepress.themeConfig.nav]]
text = "License"
link = "/license/"

[[vitepress.themeConfig.nav]]
text = "API"
link = "/ref/{{ package_name }}"

[[vitepress.themeConfig.footer]]
copyright = "Copyright © {{ year }} {{ copyright_holder }}"
