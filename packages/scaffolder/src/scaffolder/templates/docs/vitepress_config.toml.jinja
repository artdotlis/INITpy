# VitePress config

[site]
title = "{{ project_name }}"
description = "{{ project_name }} documentation"

[vitepress]
base = "/{{ project_name }}/"
cleanUrls = true
lastUpdated = true
srcDir = "src"
theme = "./theme"

[vitepress.markdown.theme]
light = "vitesse-light"
dark = "vitesse-dark"

[vitepress.themeConfig]
socialLinks = []
license = "{{ license }}"

[vitepress.themeConfig.logo]
value = "🛠️"

[vitepress.themeConfig.search]
provider = "local"

[[vitepress.themeConfig.nav]]
text = "Home"
link = "/"

[[vitepress.themeConfig.nav]]
text = "About"
link = "/about/"

[[vitepress.themeConfig.nav]]
text = "License"
link = "/license/"

[[vitepress.themeConfig.nav]]
text = "API"
link = "/ref/"

[[vitepress.themeConfig.footer]]
copyright = "Copyright © {{ year }} {{ copyright_holder }}"
