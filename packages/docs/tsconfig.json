{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "paths": {
            "@theme/*": ["./.vitepress/theme/*"],
            "@/*": ["./src/*"]
        }
    },
    "contentMappers": [
        {
            "package": "@vue/content-mapper",
            "extensions": [".vue"]
        }
    ],
    "include": [".vitepress/**/*.ts", ".vitepress/**/*.vue", "src/**/*.ts"]
}
