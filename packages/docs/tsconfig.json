{
    "compilerOptions": {
        "declaration": true,
        "esModuleInterop": true,
        "module": "ES2022",
        "moduleResolution": "bundler",
        "outDir": "dist",
        "paths": {
            "@/*": ["./*"],
            "@theme/*": ["./.vitepress/theme/*"]
        },
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2022"
    },
    "include": [
        ".vitepress/**/*.ts",
        ".vitepress/**/*.vue",
        ".vitepress/**/*.css",
        "tests/**/*.ts"
    ]
}
