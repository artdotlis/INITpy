{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "baseUrl": "..",
        "paths": {
            "@theme/*": [".vitepress/theme/*"],
            "@/*": ["src/*"]
        }
    },
    "include": ["theme/**/*.ts", "theme/**/*.vue", "src/**/*.ts"]
}
